rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "leminhhaukrb16@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.elo is number && data.elo >= 0 && data.elo <= 5000 &&
             data.coins is number && data.coins >= 0 &&
             data.level is number && data.level >= 1;
    }

    // User profiles collection
    match /users/{userId} {
      allow get: if isValidId(userId);
      allow list: if isSignedIn();

      allow create: if (isOwner(userId) || isAdmin()) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == userId;

      allow update: if (isOwner(userId) || isAdmin()) &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().id == existing().id;

      allow delete: if isAdmin() && isValidId(userId);
    }

    // Validation for GameMatch
    function isValidGameMatch(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.playerXId is string && data.playerXId.size() <= 128 &&
             data.winner is string && data.winner in ['X', 'O', 'draw'] &&
             data.turnsCount is number && data.turnsCount >= 0;
    }

    // Matches collection
    match /matches/{matchId} {
      allow get: if isValidId(matchId);
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       isValidId(matchId) &&
                       isValidGameMatch(incoming());

      allow update, delete: if isAdmin();
    }

    // System Notifications collection (Updates, Game versions, Events)
    match /system_notifications/{notifId} {
      allow read: if isValidId(notifId);
      allow write: if isAdmin() && isValidId(notifId);
    }

    // Player activity sessions logs (Exclusive to Admin)
    match /player_sessions/{sessionId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidId(sessionId);
      allow update, delete: if isAdmin();
    }
  }
}
