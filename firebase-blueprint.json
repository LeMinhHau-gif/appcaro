{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing player statistics, ELO ranking, coins, role delegation, and unlocks",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 150 },
        "title": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 500 },
        "elo": { "type": "number" },
        "coins": { "type": "number" },
        "gems": { "type": "number" },
        "stars": { "type": "number" },
        "level": { "type": "number" },
        "xp": { "type": "number" },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "draws": { "type": "number" },
        "winStreak": { "type": "number" },
        "status": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["user", "vip", "moderator", "pro", "admin"] },
        "roleExpiresAt": { "type": "string", "maxLength": 50 },
        "roleGrantedAt": { "type": "string", "format": "date-time" },
        "roleGrantedBy": { "type": "string", "maxLength": 150 },
        "roleTier": { "type": "string", "enum": ["1_month", "3_months", "6_months", "12_months", "permanent"] },
        "equippedTheme": { "type": "string", "maxLength": 50 },
        "equippedSkin": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string", "format": "date-time" },
        "lastActiveAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "elo", "coins", "level"]
    },
    "GameMatch": {
      "title": "GameMatch",
      "description": "Record of a completed Gomoku game match",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "playerXId": { "type": "string", "maxLength": 128 },
        "playerXName": { "type": "string", "maxLength": 100 },
        "playerOId": { "type": "string", "maxLength": 128 },
        "playerOName": { "type": "string", "maxLength": 100 },
        "winner": { "type": "string", "enum": ["X", "O", "draw"] },
        "turnsCount": { "type": "number" },
        "gameMode": { "type": "string", "maxLength": 50 },
        "roomCode": { "type": "string", "maxLength": 20 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "playerXId", "winner", "turnsCount"]
    },
    "SystemNotification": {
      "title": "SystemNotification",
      "description": "In-game announcement, update notice or tournament event published by Admin",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 200 },
        "content": { "type": "string", "maxLength": 2000 },
        "type": { "type": "string", "enum": ["update", "event", "reward", "system"] },
        "version": { "type": "string", "maxLength": 50 },
        "isPinned": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "content", "type"]
    },
    "PlayerActionLog": {
      "title": "PlayerActionLog",
      "description": "Comprehensive audit log of player operations, game activity, and admin privilege grants",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 150 },
        "action": { "type": "string", "maxLength": 50 },
        "details": { "type": "string", "maxLength": 1000 },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "action", "details"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public profile and game progression data for each player"
    },
    "/matches/{matchId}": {
      "schema": "GameMatch",
      "description": "History of game matches played"
    },
    "/system_notifications/{notifId}": {
      "schema": "SystemNotification",
      "description": "System notices and update logs accessible by all users and managed by Admin"
    },
    "/player_action_logs/{logId}": {
      "schema": "PlayerActionLog",
      "description": "Player operations and action audit logs managed exclusively by Admin"
    }
  }
}
